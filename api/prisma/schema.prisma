datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  SALESMAN
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  CREDIT_DUE
  ONLINE_CARD
}

enum OrderStatus {
  // POS & Legacy Statuses
  COMPLETED
  PENDING_VERIFICATION
  CANCELLED
  
  // Expanded E-commerce Parcel Lifecycle Stages
  ONLINE_PLACED
  PENDING
  ACCEPTED
  PROCESSING
  ON_THE_WAY
  DELIVERED
  REJECTED
  DELIVERY_FAILED
}

model User {
  id           String       @id @default(uuid())
  name         String
  phone        String       @unique
  email        String?      @unique
  passwordHash String
  role         Role         @default(SALESMAN)
  permissions  Json         // Dynamic permissions e.g. { "canViewProfit": false, "canEditStock": false }
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  sales        Sale[]       @relation("CreatedSales")
  expenses     Expense[]
  auditLogs    AuditLog[]
}

model Customer {
  id           String            @id @default(uuid())
  name         String
  phone        String            @unique
  email        String?           @unique
  address      String?
  passwordHash String?           // Optional for online customers who register accounts
  totalDues    Decimal           @default(0.00) @db.Decimal(10, 2) // Dues balance (Baki)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  sales        Sale[]
  duePayments  DuePayment[]
  otpCodes     OTPVerification[]
  cartItems    CartItem[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id            String       @id @default(uuid())
  sku           String       @unique
  name          String
  categoryId    String?
  brandId       String?
  size          String?      // e.g., 6 inc, 5 meter
  color         String?
  unit          String       @default("pieces") // pieces, meter, kg
  buyingPrice   Decimal      @db.Decimal(10, 2)
  sellingPrice  Decimal      @db.Decimal(10, 2)
  stockQuantity Int          @default(0)
  reorderLevel  Int          @default(5)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // --- E-commerce Core Additions ---
  imageUrl      String?      // Primary thumbnail
  imageUrls     String[]     // Multiple gallery photos for web storefront
  isFeatured    Boolean      @default(false)
  isPublished   Boolean      @default(true)  // Show/Hide in e-commerce store
  allowCustomLength Boolean  @default(false) // Allow buyers to specify custom length/dimension
  description   String?

  category      Category?    @relation(fields: [categoryId], references: [id])
  brand         Brand?       @relation(fields: [brandId], references: [id])
  saleItems     SaleItem[]
  cartItems     CartItem[]
}

model DeliveryZone {
  id               String   @id @default(uuid())
  name             String   @unique // e.g., Inside Dhaka, Chittagong, Sylhet
  charge           Decimal  @default(60.00) @db.Decimal(10, 2)
  allowCashOnDelivery Boolean @default(true) // Toggle COD support per delivery address/zone
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Sale {
  id             String         @id @default(uuid())
  invoiceNo      String         @unique
  customerId     String
  userId         String?        // Nullable for online self-checkout orders
  totalAmount    Decimal        @db.Decimal(10, 2)
  paidAmount     Decimal        @db.Decimal(10, 2)
  dueAmount      Decimal        @db.Decimal(10, 2)
  paymentMethod  PaymentMethod  @default(CASH)
  status         OrderStatus    @default(COMPLETED)
  createdAt      DateTime       @default(now())

  // --- E-commerce Checkout & Parcel Additions ---
  isOnlineOrder    Boolean      @default(false)
  customerName     String?      // Captured at checkout
  customerPhone    String?      // Captured at checkout
  customerEmail    String?      // Captured at checkout
  deliveryAddress  String?
  shippingCharge   Decimal      @default(0.00) @db.Decimal(10, 2)
  transactionId    String?      // Gateway transaction reference (e.g. bKash / SSLCommerz ID)

  customer       Customer       @relation(fields: [customerId], references: [id])
  user           User?          @relation("CreatedSales", fields: [userId], references: [id])
  items          SaleItem[]
  duePayments    DuePayment[]
}

model SaleItem {
  id           String   @id @default(uuid())
  saleId       String
  productId    String
  quantity     Int
  customLength Decimal? @db.Decimal(10, 2) // Custom length entered by buyer if enabled
  unitPrice    Decimal  @db.Decimal(10, 2)
  subTotal     Decimal  @db.Decimal(10, 2)

  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
}

model CartItem {
  id           String   @id @default(uuid())
  customerId   String
  productId    String
  quantity     Int      @default(1)
  customLength Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model DuePayment {
  id            String         @id @default(uuid())
  saleId        String?
  customerId    String
  amountPaid    Decimal        @db.Decimal(10, 2)
  paymentMethod PaymentMethod  @default(CASH)
  verified      Boolean        @default(true)
  notes         String?
  createdAt     DateTime       @default(now())

  sale          Sale?          @relation(fields: [saleId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
}

enum ExpenseChannel {
  POS
  ECOMMERCE
  BOTH
}

model Expense {
  id            String   @id @default(uuid())
  title         String
  category      String
  amount        Decimal  @db.Decimal(10, 2)
  channel       ExpenseChannel @default(BOTH) // Added field to target POS, ECOMMERCE, or BOTH
  recordedById  String
  date          DateTime @default(now())
  notes         String?

  spanType      String   @default("DAILY")
  durationValue Int      @default(1)
  endDate       DateTime?

  recordedBy    User     @relation(fields: [recordedById], references: [id])
}

model OTPVerification {
  id         String   @id @default(uuid())
  customerId String
  phone      String
  code       String
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
}

model SystemSettings {
  id                    String   @id @default("global_config")
  shopName              String   @default("Hardware Shop")
  requireDueOtpVerify   Boolean  @default(true)
  requireOrderOtpVerify Boolean  @default(true) // Admin toggle for online order OTP verification
  smsGatewayApiKey      String?
  smsSenderId           String?
  bkashMerchantId       String?
  bkashAppKey           String?
  sslCommerzStoreId     String?
  sslCommerzStorePassword String?
  updatedAt             DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}